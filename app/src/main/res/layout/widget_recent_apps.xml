<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="14dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="2dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_title"
            android:textColor="#F2F2F4"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/edit_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_circle"
            android:contentDescription="@string/edit_pinned"
            android:padding="9dp"
            android:src="@drawable/ic_edit" />

        <ImageView
            android:id="@+id/search_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_circle"
            android:contentDescription="@string/search_apps"
            android:padding="9dp"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <!-- Pinned row: fixed, does not scroll -->
    <LinearLayout
        android:id="@+id/pinned_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/pin_cell0"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/pin0"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/pin_cell1"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/pin1"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/pin_cell2"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/pin2"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/pin_cell3"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/pin3"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/pin_cell4"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/pin4"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pinned_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/widget_divider"
        android:visibility="gone" />

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="24dp"
        android:listSelector="@android:color/transparent"
        android:numColumns="5"
        android:paddingBottom="14dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="22dp" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_loading"
        android:textColor="#8A8D97"
        android:textSize="13sp" />
</LinearLayout>
